# Laravel REST API base URL (used when mock mode is disabled)
VITE_API_URL=http://127.0.0.1:8000/api

# Frontend demo mode. "true" (default) uses local mock services.
# Set to "false" to route all module requests through the Axios API layer.
VITE_USE_MOCK_API=true

# Simulated network delay in milliseconds for mock services (set 0 for instant).
VITE_MOCK_LATENCY=220
